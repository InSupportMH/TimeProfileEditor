<client:ViewItemWpfUserControl x:Class="TimeProfileEditor.Views.TimeProfileEditorView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:client="clr-namespace:VideoOS.Platform.Client;assembly=VideoOS.Platform"
                              xmlns:views="clr-namespace:TimeProfileEditor.Views"
                              xmlns:vm="clr-namespace:TimeProfileEditor.ViewModels"
                              mc:Ignorable="d"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              d:DesignHeight="700" d:DesignWidth="1200">

    <client:ViewItemWpfUserControl.Resources>
        <views:TimeSpanToStringConverter x:Key="TimeConverter" />
        <views:NullOrEmptyToVisibilityConverter x:Key="HasContent" />
        <views:CountToVisibilityConverter x:Key="HasItems" />
        <views:SeverityToBrushConverter x:Key="SeverityBrush" />
        <views:DateToStringConverter x:Key="DateConverter" />
        <views:KindToVisibilityConverter x:Key="KindVis" />
        <views:NotBooleanConverter x:Key="NotBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="Surface" Color="#1C1E21" />
        <SolidColorBrush x:Key="Panel" Color="#24262A" />
        <SolidColorBrush x:Key="PanelBorder" Color="#34373C" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA0A8" />
        <SolidColorBrush x:Key="Accent" Color="#2E8BCE" />
        <SolidColorBrush x:Key="AccentHover" Color="#3A9BE0" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C1F" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2E3238" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3F46" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The round "?" and "i". Not based on the ordinary button style: these carry a single
             glyph rather than a word, so they are square, circular and have no side margin of
             their own to keep them from drifting apart from each other. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#2A2D32" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="13">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#2A2D32" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="3">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" x:Name="Txt" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </client:ViewItemWpfUserControl.Resources>

    <Grid Background="{StaticResource Surface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Profile list -->
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tidsprofiler" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <TextBox Grid.Row="1" x:Name="FilterBox" Margin="0,0,0,8"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Sök bland tidsprofiler" />

                <ListBox Grid.Row="2" x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding VisibleProfiles}"
                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                                Padding="{TemplateBinding Padding}" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2F343A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Sunclock" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Visibility="{Binding IsSunclock, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3" Content="Uppdatera listan" Command="{Binding ReloadCommand}"
                        Margin="0,8,0,0" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Editor -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='Ingen tidsprofil vald'}"
                               FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProfileSubtitle}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Top right of the whole window, and deliberately outside everything that a
                     profile, a permission or a reachable server can disable. These two answer
                     "what is this" and "how does it work", which are the questions people ask
                     precisely when the rest of the screen is not cooperating. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="?" Style="{StaticResource IconButton}"
                            Command="{Binding ShowHelpCommand}"
                            ToolTip="Så fungerar Tidsprofiler" />
                    <Button Content="i" Style="{StaticResource IconButton}"
                            Command="{Binding ShowAboutCommand}"
                            ToolTip="Om Tidsprofiler – version, utvecklare och licens" />
                </StackPanel>
            </Grid>

            <!-- Permission / install banner -->
            <Border Grid.Row="1" Background="#33322A" BorderBrush="#6B6038" BorderThickness="1"
                    CornerRadius="3" Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding PermissionBanner, Converter={StaticResource HasContent}}">
                <StackPanel>
                    <TextBlock Text="{Binding PermissionBanner}" TextWrapping="Wrap" Foreground="#E8C06A" />
                    <!-- The whole picture is too much for a banner but is exactly what a support
                         question needs, so it goes on the clipboard on request instead. -->
                    <Button Content="Kopiera diagnostik" Command="{Binding CopyDiagnosticsCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" />
                </StackPanel>
            </Border>

            <!-- Toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Lägg till tid" Command="{Binding AddEntryCommand}" />
                    <Button Content="Lägg till datum" Command="{Binding AddDateCommand}" />
                    <Button Content="Ta bort vald" Command="{Binding DeleteEntryCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Avbryt" Command="{Binding CancelCommand}" />
                    <Button Content="Spara" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="0" MinWidth="90" />
                </StackPanel>
            </Grid>

            <!-- Month calendar + week grid + selected entry panel -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    The calendar of real dates, next to the pattern that produces them. Both are on
                    screen at once on purpose: the week grid says what the rule is, this says what
                    the rule lands on - including that it stopped applying last month.
                -->
                <Border Grid.Column="0" Width="330" Margin="0,0,12,0" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="‹" Command="{Binding PreviousMonthCommand}"
                                            Padding="9,1" FontSize="15" Margin="0,0,4,0"
                                            ToolTip="Föregående månad" />
                                    <Button Content="›" Command="{Binding NextMonthCommand}"
                                            Padding="9,1" FontSize="15" Margin="0,0,8,0"
                                            ToolTip="Nästa månad" />
                                    <TextBlock Text="{Binding CalendarMonthLabel}" FontSize="14"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Idag" Command="{Binding TodayCommand}"
                                        HorizontalAlignment="Right" Padding="9,3" FontSize="11" Margin="0" />
                            </Grid>

                            <views:MonthCalendarControl x:Name="MonthGrid"
                                                        Month="{Binding CalendarMonth}"
                                                        HighlightEntry="{Binding SelectedEntry}" />

                            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,8,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Från" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding NewTimeFrom, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding NewTimeAllDay, Converter={StaticResource NotBool}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Till" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding NewTimeTo, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding NewTimeAllDay, Converter={StaticResource NotBool}}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Heldag" IsChecked="{Binding NewTimeAllDay}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />

                            <Button Content="Lägg till på valda datum" Command="{Binding AddOnDatesCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,5"
                                    ToolTip="Skapar en bokning på varje vald dag - bara de dagarna." />
                            <Button Content="Lägg till som veckomönster"
                                    Command="{Binding AddWeeklyFromSelectionCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,5"
                                    ToolTip="Skapar en återkommande tid på de veckodagar valet rör, giltig från första till sista valda datum." />
                            <Button Content="Ta bort tid på valda datum" Command="{Binding RemoveOnDatesCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,10" />

                            <!-- Legend: the strip in each day cell and the blocks in the week grid
                                 are the only things on screen whose colours are not
                                 self-explanatory. The same three meanings apply to both panels. -->
                            <WrapPanel Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                                    <Rectangle Width="10" Height="10" Fill="#357FB8" VerticalAlignment="Center" />
                                    <TextBlock Text="Veckomönster" Style="{StaticResource Caption}"
                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,3">
                                    <Rectangle Width="10" Height="10" Fill="#D0943E" VerticalAlignment="Center" />
                                    <TextBlock Text="Enstaka datum" Style="{StaticResource Caption}"
                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3"
                                            ToolTip="Tiden finns kvar i profilen men dess giltighetsperiod täcker inte veckan som visas.">
                                    <Rectangle Width="10" Height="10" Fill="#2A4FA3DA" Stroke="#994FA3DA"
                                               StrokeThickness="1" StrokeDashArray="2 2" VerticalAlignment="Center" />
                                    <TextBlock Text="Gäller inte denna vecka" Style="{StaticResource Caption}"
                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="{Binding CalendarNote}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Foreground="#E8C06A"
                                       Visibility="{Binding CalendarNote, Converter={StaticResource HasContent}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="3">
                    <views:WeekScheduleControl x:Name="WeekGrid"
                                               Week="{Binding WeekStart}"
                                               SelectedEntry="{Binding SelectedEntry, Mode=TwoWay}" />
                </Border>

                <Border Grid.Column="2" Width="250" Margin="12,0,0,0" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Vald tid" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <StackPanel Visibility="{Binding SelectedEntry, Converter={StaticResource HasContent},
                                                 ConverterParameter=invert}">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Ingen tid är vald. Dra i kalendern för att lägga till en ny tid, eller klicka på en befintlig för att ändra den." />
                        </StackPanel>

                        <!-- One-off date -->
                        <StackPanel Visibility="{Binding SelectedEntry, Converter={StaticResource KindVis},
                                                 ConverterParameter=SingleOccurrence}">
                            <TextBlock Text="Datum" Style="{StaticResource Caption}" />
                            <TextBox x:Name="DateBox" Margin="0,0,0,10"
                                     LostFocus="OnDateCommitted" KeyDown="OnTimeBoxKeyDown"
                                     ToolTip="Format: 2026-12-24" />

                            <CheckBox x:Name="AllDayBox" Content="Heldag" Foreground="{StaticResource TextPrimary}"
                                      Margin="0,0,0,10" Click="OnAllDayToggled" />

                            <Grid Margin="0,0,0,10" x:Name="DateTimeFields">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Från" Style="{StaticResource Caption}" />
                                    <TextBox x:Name="DateFromBox" LostFocus="OnDateCommitted" KeyDown="OnTimeBoxKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Till" Style="{StaticResource Caption}" />
                                    <TextBox x:Name="DateToBox" LostFocus="OnDateCommitted" KeyDown="OnTimeBoxKeyDown" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Benämning" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding SelectedEntry.Subject, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,0,12" />

                            <Button Content="Ta bort detta datum" Command="{Binding DeleteEntryCommand}"
                                    HorizontalAlignment="Stretch" Margin="0" />
                        </StackPanel>

                        <!-- Weekly pattern -->
                        <StackPanel x:Name="EntryEditor"
                                    Visibility="{Binding SelectedEntry, Converter={StaticResource KindVis},
                                                 ConverterParameter=Weekly}">
                            <TextBlock Text="Dagar" Style="{StaticResource Caption}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" x:Name="DayToggles">
                                <ToggleButton x:Name="DayMon" Content="Mån" Style="{StaticResource DayToggle}" Click="OnDayToggled" Tag="Monday" />
                                <ToggleButton x:Name="DayTue" Content="Tis" Style="{StaticResource DayToggle}" Click="OnDayToggled" Tag="Tuesday" />
                                <ToggleButton x:Name="DayWed" Content="Ons" Style="{StaticResource DayToggle}" Click="OnDayToggled" Tag="Wednesday" />
                                <ToggleButton x:Name="DayThu" Content="Tor" Style="{StaticResource DayToggle}" Click="OnDayToggled" Tag="Thursday" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,-8,0,12">
                                <ToggleButton x:Name="DayFri" Content="Fre" Style="{StaticResource DayToggle}" Click="OnDayToggled" Tag="Friday" />
                                <ToggleButton x:Name="DaySat" Content="Lör" Style="{StaticResource DayToggle}" Click="OnDayToggled" Tag="Saturday" />
                                <ToggleButton x:Name="DaySun" Content="Sön" Style="{StaticResource DayToggle}" Click="OnDayToggled" Tag="Sunday" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Vardagar" Padding="8,3" FontSize="11" Click="OnPresetWeekdays" />
                                <Button Content="Alla" Padding="8,3" FontSize="11" Click="OnPresetAll" Margin="0" />
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Från" Style="{StaticResource Caption}" />
                                    <TextBox x:Name="StartBox" LostFocus="OnTimeBoxCommitted" KeyDown="OnTimeBoxKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Till" Style="{StaticResource Caption}" />
                                    <TextBox x:Name="EndBox" LostFocus="OnTimeBoxCommitted" KeyDown="OnTimeBoxKeyDown" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="CrossMidnightHint" Style="{StaticResource Caption}"
                                       Foreground="#E8C06A" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="Tiden fortsätter in på nästa dag." Margin="0,0,0,10" />

                            <Border Background="#1F2226" CornerRadius="3" Padding="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Giltighetsperiod" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                    <TextBlock Text="Gäller från" Style="{StaticResource Caption}" />
                                    <TextBox x:Name="RangeStartBox" Margin="0,0,0,8"
                                             LostFocus="OnRangeCommitted" KeyDown="OnTimeBoxKeyDown"
                                             ToolTip="Format: 2026-06-01" />

                                    <CheckBox x:Name="OpenEndedBox" Content="Tills vidare"
                                              Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"
                                              Click="OnOpenEndedToggled" />

                                    <StackPanel x:Name="RangeEndPanel">
                                        <TextBlock Text="Gäller till och med" Style="{StaticResource Caption}" />
                                        <TextBox x:Name="RangeEndBox" LostFocus="OnRangeCommitted" KeyDown="OnTimeBoxKeyDown" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Benämning" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding SelectedEntry.Subject, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,0,12" />

                            <Button Content="Ta bort denna tid" Command="{Binding DeleteEntryCommand}"
                                    HorizontalAlignment="Stretch" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- One-off dates -->
            <StackPanel Grid.Row="4" Margin="0,12,0,0"
                        Visibility="{Binding DateEntries.Count, Converter={StaticResource HasItems}}">
                <TextBlock Text="Enstaka datum" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="DateList" ItemsSource="{Binding DateEntries}" Background="Transparent"
                         BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" MaxHeight="112"
                         SelectionChanged="OnDateListSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2F343A" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Description}" />
                                <TextBlock Grid.Column="1" Text="{Binding Subject}"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Entries the plugin refuses to rewrite -->
            <Expander Grid.Row="5" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}"
                      Visibility="{Binding ReadOnlyEntries.Count, Converter={StaticResource HasItems}}">
                <Expander.Header>
                    <TextBlock Text="Övriga tider i profilen (visas men ändras inte här)"
                               Foreground="{StaticResource TextSecondary}" FontSize="12" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding ReadOnlyEntries}" Margin="8,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ServerDescription}" Style="{StaticResource Caption}"
                                       Margin="0,0,0,3" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- Status -->
            <Border Grid.Row="6" Margin="0,12,0,0" Padding="10,8" CornerRadius="3" Background="#22262A"
                    Visibility="{Binding StatusMessage, Converter={StaticResource HasContent}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityBrush}}" />
            </Border>
        </Grid>

        <!--
            Help and information. One panel with two contents rather than two panels: they are the
            same thing to close, the same thing to scroll, and only one can be open. It lies over
            the editor instead of replacing it, so whatever was half-edited is still there,
            untouched, when it closes.
        -->
        <Border Grid.ColumnSpan="2" Background="#B0000000" Padding="40"
                MouseLeftButtonDown="OnInfoBackdropClicked"
                Visibility="{Binding IsInfoOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="4" MaxWidth="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="OnInfoCardClicked">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding InfoTitle}" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                Command="{Binding CloseInfoCommand}" ToolTip="Stäng (Esc)" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding HelpTopics}"
                                          Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,12,15">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#9CC9EC" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12.5"
                                                       LineHeight="19" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding AboutDescription}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding AboutFacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,12,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Stäng" Command="{Binding CloseInfoCommand}"
                            HorizontalAlignment="Right" Margin="0,14,0,0" MinWidth="90" />
                </Grid>
            </Border>
        </Border>

        <!-- Busy overlay -->
        <Border Grid.ColumnSpan="2" Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Hämtar…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource TextPrimary}" />
        </Border>
    </Grid>
</client:ViewItemWpfUserControl>
